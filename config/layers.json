{
  "_doc": "Boundary layers Joiner can join to. scripts/get_layers.mjs downloads each from DataSF and writes data/boundaries/<id>.geojson plus data/boundaries/index.json. key = feature property rows are joined on; name = label shown in the side panel; keep = properties kept (all others dropped). Neighborhood sets appear in the Neighborhood tab in the order listed here; \"default\": true marks the one it opens with. match = how row values are normalized before matching: stripPrefix (regex, case-insensitive), caseInsensitive, collapseSpace, delimiter (split one cell into several keys, e.g. a multi-select \"1,3\"). nameTemplate (optional) builds the label from properties, e.g. \"District {sup_dist}\". labelTemplate (optional) is the short ID drawn on the map, e.g. \"D{sup_dist}\". labelExtras are extra label lines the map can show for that layer: prop to read, lastWord to keep only the last word, template with {} for the value, default to show it without being picked. localFiles (instead of dataset) builds a layer from GeoJSON already in the repo. In labelExtras, hover shows the line in the hover tooltip and popup, list shows it in the area list, values maps raw values to text. short (optional) is the name shown on a tab when the full label is long.",
  "portal": "https://data.sf.gov",
  "precision": 6,
  "mainlandBbox": [
    -122.53,
    37.7,
    -122.34,
    37.84
  ],
  "layers": [
    {
      "id": "supervisor_districts",
      "label": "Supervisor District",
      "tab": "District",
      "dataset": "cqbw-m5m3",
      "page": "https://data.sf.gov/-/Map-of-Current-Supervisor-Districts/tadv-nifg",
      "key": "sup_dist",
      "name": "sup_dist_name",
      "nameTemplate": "District {sup_dist}",
      "labelTemplate": "D{sup_dist}",
      "labelExtras": [
        {
          "id": "supervisor",
          "label": "Supervisor",
          "prop": "sup_name",
          "lastWord": true,
          "default": true,
          "hover": true,
          "list": true
        }
      ],
      "keep": [
        "sup_dist",
        "sup_dist_abbrev",
        "sup_dist_name",
        "sup_name"
      ],
      "expectCount": 11,
      "match": {
        "stripPrefix": "^(supervisorial district|supervisor district|district|d)\\s*",
        "caseInsensitive": true,
        "delimiter": ","
      }
    },
    {
      "id": "zip_codes",
      "label": "ZIP Code",
      "tab": "ZIP",
      "dataset": "srq6-hmpi",
      "page": "https://data.sf.gov/-/San-Francisco-ZIP-Codes/srq6-hmpi",
      "key": "zip_code",
      "name": "zip_code",
      "keep": [
        "zip_code",
        "po_name"
      ],
      "mergeByKey": true,
      "match": {
        "delimiter": ","
      }
    },
    {
      "id": "sf_find_neighborhoods",
      "label": "SF Find Neighborhoods (117)",
      "tab": "Neighborhood",
      "default": true,
      "dataset": "pty2-tcw4",
      "page": "https://data.sf.gov/-/SF-Find-Neighborhoods/pty2-tcw4",
      "key": "name",
      "name": "name",
      "keep": [
        "name",
        "link"
      ],
      "match": {
        "caseInsensitive": true,
        "collapseSpace": true
      }
    },
    {
      "id": "analysis_neighborhoods",
      "label": "Analysis Neighborhoods (41)",
      "tab": "Neighborhood",
      "dataset": "p5b7-5n3h",
      "page": "https://data.sf.gov/-/Analysis-Neighborhoods/p5b7-5n3h",
      "key": "nhood",
      "name": "nhood",
      "keep": [
        "nhood"
      ],
      "expectCount": 41,
      "match": {
        "caseInsensitive": true,
        "collapseSpace": true
      }
    },
    {
      "id": "planning_neighborhoods",
      "label": "Planning Neighborhood Groups (37)",
      "tab": "Neighborhood",
      "dataset": "mw29-m2za",
      "page": "https://data.sf.gov/-/Planning-Neighborhood-Groups-Map/iacs-ws63",
      "key": "neighborho",
      "name": "neighborho",
      "keep": [
        "neighborho"
      ],
      "match": {
        "caseInsensitive": true,
        "collapseSpace": true
      },
      "short": "Planning Neighborhoods"
    },
    {
      "id": "realtor_neighborhoods",
      "label": "Realtor Neighborhoods (92)",
      "tab": "Neighborhood",
      "dataset": "5gzd-g9ns",
      "page": "https://data.sf.gov/-/Realtor-Neighborhoods/5gzd-g9ns",
      "key": "nbrhood",
      "name": "nbrhood",
      "labelExtras": [
        {
          "id": "sfar_district",
          "label": "Realtor district",
          "prop": "sfar_distr"
        }
      ],
      "keep": [
        "nbrhood",
        "nid",
        "sfar_distr"
      ],
      "match": {
        "caseInsensitive": true,
        "collapseSpace": true
      }
    },
    {
      "id": "wof_neighbourhoods",
      "label": "Who's on First Neighbourhoods (116)",
      "tab": "Neighborhood",
      "localFiles": [
        "data/wof/neighbourhoods.geojson",
        "data/wof/neighbourhoods-unverified.geojson"
      ],
      "page": "https://spelunker.whosonfirst.org/id/85922583/descendants/?placetype=neighbourhood",
      "key": "name",
