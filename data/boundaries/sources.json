          "id": "supervisor",
          "label": "Supervisor",
          "prop": "sup_name",
          "lastWord": true,
          "default": true,
          "hover": true,
          "list": true
        }
      ],
      "keep": [
        "sup_dist",
        "sup_dist_abbrev",
        "sup_dist_name",
        "sup_name"
